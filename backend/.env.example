# ============================================================================
# DATABASE - Supabase Configuration
# ============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Primary Database URL (required)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Локально без облака (выберите один вариант):
# Docker (из корня skladpro: docker compose up -d postgresql):
# DATABASE_URL=postgresql://skladpro:skladpro_password@localhost:5432/skladpro
# Postgres на Mac/Homebrew — пользователь ОС, БД skladpro должна существовать (createdb skladpro):
# DATABASE_URL=postgresql://ВАШ_ПОЛЬЗОВАТЕЛЬ@localhost:5432/skladpro

# Если при старте: "could not translate host name" — Supabase недоступен; переключитесь на локальный URL.

# Database Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
SQL_ECHO=false

# ============================================================================
# SECURITY
# ============================================================================
SECRET_KEY=your-secret-key-here-change-this-in-production
# CORS: в main.py уже разрешены localhost/LAN и *.vercel.app. Свой домен (например app.example.com) добавьте сюда через запятую.
ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://your-app.vercel.app

# ============================================================================
# CACHE & REDIS (Optional)
# ============================================================================
REDIS_URL=redis://localhost:6379
CACHE_ENABLED=true
CACHE_TTL=3600

# ============================================================================
# API CONFIGURATION
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000
# Railway / прод: ENVIRONMENT=production (uvicorn без --reload)
ENVIRONMENT=development

# ============================================================================
# FEATURES
# ============================================================================
NOTIFICATIONS_ENABLED=true

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=INFO
