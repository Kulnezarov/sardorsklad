# ============================================================================
# DATABASE (PostgreSQL на своём сервере или Docker)
# ============================================================================
# Docker Compose (сервис postgresql в этом репозитории):
# DATABASE_URL=postgresql://skladpro:skladpro_password@localhost:5432/skladpro
# В контейнере backend на VPS compose подставляет DATABASE_URL сам — в .env можно не дублировать.
# Локальный Postgres (Homebrew и т.д.):
# DATABASE_URL=postgresql://ВАШ_ПОЛЬЗОВАТЕЛЬ@localhost:5432/skladpro

DATABASE_URL=postgresql://skladpro:skladpro_password@localhost:5432/skladpro

# Database Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
SQL_ECHO=false

# ============================================================================
# SECURITY
# ============================================================================
# ОБЯЗАТЕЛЬНО в production: длина >= 32 символа. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# При ENVIRONMENT=production сервер НЕ запустится с дефолтным/коротким ключом.
SECRET_KEY=your-secret-key-here-change-this-in-production
# Доверенный прокси (Caddy/nginx) выставляет реальный IP клиента в этом заголовке.
# Используется для rate-limit; НЕ доверяем X-Forwarded-For от клиента напрямую.
# TRUST_PROXY=true
# TRUSTED_PROXY_HEADER=x-real-ip
# Лимиты (in-memory, на воркер): вход, поиск заказа, создание заказа
# LOGIN_RATE_LIMIT=10
# LOGIN_RATE_WINDOW_SEC=300
# PUBLIC_LOOKUP_RATE_LIMIT=20
# PUBLIC_LOOKUP_RATE_WINDOW_SEC=60
# PUBLIC_ORDER_RATE_LIMIT=30
# PUBLIC_ORDER_RATE_WINDOW_SEC=60
# JWT (подпись access_token; совпадает с SECRET_KEY)
# Срок access_token по умолчанию: до следующего «сброса» каждый день в 00:03 (часовой пояс ниже).
# После этого срока нужен повторный вход (логин/пароль).
# AUTH_SESSION_DAILY_RESET=true
# AUTH_SESSION_TZ=Asia/Tashkent
# AUTH_SESSION_RESET_HOUR=0
# AUTH_SESSION_RESET_MINUTE=3
# Отключить суточный сброс и использовать только JWT_EXPIRE_MINUTES:
# AUTH_SESSION_DAILY_RESET=false
# JWT_EXPIRE_MINUTES=10080
# Публичная регистрация на сайте (по умолчанию выключена)
ALLOW_OPEN_REGISTRATION=false
# Первый админ создаётся при старте, если таблица users пуста (смените пароль в проде!)
# ADMIN_EMAIL=sardor@gmail.com
# ADMIN_PASSWORD=смените_на_сложный
# SKIP_BOOTSTRAP_ADMIN=false
# CORS: только доверенные домены (склад и клиентская витрина) + локальная разработка
ORIGINS=https://sklad.kz,https://chparts.kz,http://chparts.kz,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ============================================================================
# CACHE & REDIS (Optional)
# ============================================================================
REDIS_URL=redis://localhost:6379
CACHE_ENABLED=true
CACHE_TTL=3600

# ============================================================================
# API CONFIGURATION
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000
# Railway / прод: ENVIRONMENT=production (uvicorn без --reload)
ENVIRONMENT=development

# Фото товаров: на диске создаётся UPLOAD_DIR/products/ (JPG/PNG/WebP → всегда .avif)
# В Docker: volume на /app/uploads, см. docker-compose.vps.yml
# UPLOAD_DIR=uploads

# ============================================================================
# FEATURES
# ============================================================================
NOTIFICATIONS_ENABLED=true
# При заказе с сайта: сразу списывать остаток (true) или только после подтверждения менеджером (false)
PUBLIC_ORDER_RESERVE_STOCK_IMMEDIATELY=false
# Ссылка в Telegram-сообщении на карточку заказа
ADMIN_BASE_URL=https://sklad.kz

# ============================================================================
# TELEGRAM — ежедневный отчёт о продажах (21:00 по умолчанию)
# ============================================================================
# Токен от @BotFather; chat_id после /start у бота — см. docs/telegram-bot.md
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Часовой пояс для границ «дня» и времени cron в планировщике:
# TELEGRAM_REPORT_TZ=Asia/Almaty
# TELEGRAM_REPORT_HOUR=21
# TELEGRAM_REPORT_MINUTE=0
# TELEGRAM_DAILY_REPORT=true
# Команды /категории, /поиск и т.д. в Telegram (long polling):
# TELEGRAM_COMMANDS=true

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=INFO
