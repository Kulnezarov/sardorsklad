# ============================================================================
# DATABASE - Supabase Configuration
# ============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
# ВАЖНО для VPS: НЕ используйте хост db.*.supabase.co — он часто даёт только IPv6 → "Network is unreachable".
# Берите Session pooler: Supabase Dashboard → Database → Connection string → Session mode → URI.
# Пример: postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Primary Database URL (required) — на проде тот же URI, что SUPABASE_DB_URL (pooler, не db.*.supabase.co)
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Локально без облака (выберите один вариант):
# Docker (из корня skladpro: docker compose up -d postgresql):
# DATABASE_URL=postgresql://skladpro:skladpro_password@localhost:5432/skladpro
# Postgres на Mac/Homebrew — пользователь ОС, БД skladpro должна существовать (createdb skladpro):
# DATABASE_URL=postgresql://ВАШ_ПОЛЬЗОВАТЕЛЬ@localhost:5432/skladpro

# Если при старте: "could not translate host name" — Supabase недоступен; переключитесь на локальный URL.

# Database Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
SQL_ECHO=false

# ============================================================================
# SECURITY
# ============================================================================
SECRET_KEY=your-secret-key-here-change-this-in-production
# JWT (подпись access_token; совпадает с SECRET_KEY)
# JWT_EXPIRE_MINUTES=10080
# Регистрация через POST /api/v1/auth/register (после первого пользователя можно выключить)
# ALLOW_OPEN_REGISTRATION=true
# CORS: в main.py уже разрешены localhost/LAN и *.vercel.app. Свой домен (например app.example.com) добавьте сюда через запятую.
ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://194.32.142.253,http://194.32.142.253:5173,https://your-app.vercel.app

# ============================================================================
# CACHE & REDIS (Optional)
# ============================================================================
REDIS_URL=redis://localhost:6379
CACHE_ENABLED=true
CACHE_TTL=3600

# ============================================================================
# API CONFIGURATION
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000
# Railway / прод: ENVIRONMENT=production (uvicorn без --reload)
ENVIRONMENT=development

# ============================================================================
# FEATURES
# ============================================================================
NOTIFICATIONS_ENABLED=true

# ============================================================================
# AI (Gemini)
# ============================================================================
GEMINI_API_KEY=your-gemini-api-key

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=INFO
