# Шаблон для VPS. На сервере скопируйте в корень репозитория:
#   cp deploy/vps/.env.example .env.vps
# Отредактируйте .env.vps (он в .gitignore — секреты не в git).
#
# ВАЖНО: каждая строка вида KEY=value — без пробелов и без символов › > в начале строки.
# Не используйте APP_DOMAIN / API_DOMAIN: актуальный Caddyfile их не читает; два одинаковых IP
# в старом Caddy ломали запуск с ошибкой "ambiguous site definition".

# --- Текущая настройка VPS: фиксированный IP, только HTTP ---
APP_ORIGIN=http://194.32.142.253
VITE_API_URL=http://194.32.142.253/api/v1

# --- Если позже появится домен без TLS, используйте тоже HTTP:
# APP_ORIGIN=http://app.example.com
# VITE_API_URL=http://app.example.com/api/v1
